modules = ["web", "nodejs-20", "nix", "python-base-3.13"]
[nix]
channel = "stable-25_05"

[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "DATA_DIR=./data node server.js"
waitForPort = 5000

[userenv]

[userenv.shared]
WOMPI_PUBLIC_KEY = "pub_test_gjhaZFqRwKaZMBcAEBYOjYNGqzGUyPXx"
SMTP_HOST = "smtp.zoho.com"
SMTP_PORT = "465"
SMTP_USER = "admin@fourone.com.do"
SMTP_FROM = "admin@fourone.com.do"
NOTIFY_TO = "admin@fourone.com.do"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081
